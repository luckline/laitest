{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://timelens.cc https://*.vercel-insights.com; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ],
  "redirects": [
    { "source": "/lingtest.html", "destination": "/mingtest", "permanent": true },
    { "source": "/lingtest", "destination": "/mingtest", "permanent": true },
    { "source": "/lingtest-guides", "destination": "/mingtest-guides", "permanent": true },
    { "source": "/lingtest-tools", "destination": "/mingtest-tools", "permanent": true },
    { "source": "/lingtest-pricing", "destination": "/mingtest-pricing", "permanent": true },
    { "source": "/lingtest-login", "destination": "/mingtest-login", "permanent": true },
    { "source": "/lingtest-admin", "destination": "/mingtest-admin", "permanent": true }
  ],
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "api/timelens_share.py", "use": "@vercel/python" },
    { "src": "api/execute_case.js", "use": "@vercel/node" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" },
    { "src": "site-analytics.js", "use": "@vercel/static" },
    { "src": "library.js", "use": "@vercel/static" },
    { "src": "library-data.js", "use": "@vercel/static" },
    { "src": "product-nav.js", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "baidu_verify_codeva-XOPq3AJQbN.html", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "site.webmanifest", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "api-testing.js", "use": "@vercel/static" },
    { "src": "app.html", "use": "@vercel/static" },
    { "src": "lingtest-guides.html", "use": "@vercel/static" },
    { "src": "lingtest-tools.html", "use": "@vercel/static" },
    { "src": "library.html", "use": "@vercel/static" },
    { "src": "lingtest-tools.js", "use": "@vercel/static" },
    { "src": "lingtest.html", "use": "@vercel/static" },
    { "src": "lingtest-pricing.html", "use": "@vercel/static" },
    { "src": "lingtest-pricing.js", "use": "@vercel/static" },
    { "src": "lingtest-login.html", "use": "@vercel/static" },
    { "src": "lingtest-login.js", "use": "@vercel/static" },
    { "src": "lingtest-admin.html", "use": "@vercel/static" },
    { "src": "lingtest-admin.js", "use": "@vercel/static" },
    { "src": "lingtest-account.js", "use": "@vercel/static" },
    { "src": "timelens.js", "use": "@vercel/static" },
    { "src": "timelens-plan.js", "use": "@vercel/static" },
    { "src": "timelens.html", "use": "@vercel/static" },
    { "src": "timelens-route.js", "use": "@vercel/static" },
    { "src": "timelens-route.html", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "security.html", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/ai/execute_case", "destination": "/api/execute_case.js" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/img/(.*)", "destination": "/img/$1" },
    { "source": "/app.js", "destination": "/app.js" },
    { "source": "/api-testing.js", "destination": "/api-testing.js" },
    { "source": "/product-nav.js", "destination": "/product-nav.js" },
    { "source": "/baidu_verify_codeva-XOPq3AJQbN.html", "destination": "/baidu_verify_codeva-XOPq3AJQbN.html" },
    { "source": "/app", "destination": "/app.html"},
    { "source": "/library", "destination": "/library.html" },
    { "source": "/mingtest-guides", "destination": "/lingtest-guides.html" },
    { "source": "/mingtest-tools", "destination": "/lingtest-tools.html" },
    { "source": "/lingtest-tools.js", "destination": "/lingtest-tools.js" },
    { "source": "/mingtest", "destination": "/app.html" },
    { "source": "/mingtest-pricing", "destination": "/lingtest-pricing.html" },
    { "source": "/lingtest-pricing.js", "destination": "/lingtest-pricing.js" },
    { "source": "/mingtest-login", "destination": "/lingtest-login.html" },
    { "source": "/lingtest-login.js", "destination": "/lingtest-login.js" },
    { "source": "/mingtest-admin", "destination": "/lingtest-admin.html" },
    { "source": "/lingtest-admin.js", "destination": "/lingtest-admin.js" },
    { "source": "/lingtest-account.js", "destination": "/lingtest-account.js" },
    { "source": "/timelens", "destination": "/timelens.html" },
    { "source": "/timelens-plan.js", "destination": "/timelens-plan.js" },
    { "source": "/timelens-route", "destination": "/api/timelens_share.py" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
